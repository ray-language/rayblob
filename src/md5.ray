//! Incremental MD5 (RFC 1321), fed in pieces. S3 makes MD5 the ETag of every object and the
//! check of `Content-MD5`; `std/crypto/md5` hashes only a whole buffer in one call and costs
//! about 23× its input in memory, so a 64 MiB part would need ~1.5 GiB. This one keeps a
//! 64-byte block of state and reads the octets in place.

import std/hex;

pub struct Md5 {
    a: int,
    b: int,
    c: int,
    d: int,
    /// The bytes of an unfinished block, carried to the next update.
    tail: [int],
    total: int,
}

const MASK: int = 0xFFFFFFFF;

const S: [int] = [
    7,
    12,
    17,
    22,
    7,
    12,
    17,
    22,
    7,
    12,
    17,
    22,
    7,
    12,
    17,
    22,
    5,
    9,
    14,
    20,
    5,
    9,
    14,
    20,
    5,
    9,
    14,
    20,
    5,
    9,
    14,
    20,
    4,
    11,
    16,
    23,
    4,
    11,
    16,
    23,
    4,
    11,
    16,
    23,
    4,
    11,
    16,
    23,
    6,
    10,
    15,
    21,
    6,
    10,
    15,
    21,
    6,
    10,
    15,
    21,
    6,
    10,
    15,
    21
];

const K: [int] = [
    0xD76AA478,
    0xE8C7B756,
    0x242070DB,
    0xC1BDCEEE,
    0xF57C0FAF,
    0x4787C62A,
    0xA8304613,
    0xFD469501,
    0x698098D8,
    0x8B44F7AF,
    0xFFFF5BB1,
    0x895CD7BE,
    0x6B901122,
    0xFD987193,
    0xA679438E,
    0x49B40821,
    0xF61E2562,
    0xC040B340,
    0x265E5A51,
    0xE9B6C7AA,
    0xD62F105D,
    0x02441453,
    0xD8A1E681,
    0xE7D3FBC8,
    0x21E1CDE6,
    0xC33707D6,
    0xF4D50D87,
    0x455A14ED,
    0xA9E3E905,
    0xFCEFA3F8,
    0x676F02D9,
    0x8D2A4C8A,
    0xFFFA3942,
    0x8771F681,
    0x6D9D6122,
    0xFDE5380C,
    0xA4BEEA44,
    0x4BDECFA9,
    0xF6BB4B60,
    0xBEBFBC70,
    0x289B7EC6,
    0xEAA127FA,
    0xD4EF3085,
    0x04881D05,
    0xD9D4D039,
    0xE6DB99E5,
    0x1FA27CF8,
    0xC4AC5665,
    0xF4292244,
    0x432AFF97,
    0xAB9423A7,
    0xFC93A039,
    0x655B59C3,
    0x8F0CCC92,
    0xFFEFF47D,
    0x85845DD1,
    0x6FA87E4F,
    0xFE2CE6E0,
    0xA3014314,
    0x4E0811A1,
    0xF7537E82,
    0xBD3AF235,
    0x2AD7D2BB,
    0xEB86D391
];

pub fn new() -> Md5 {
    Md5 { a: 0x67452301, b: 0xEFCDAB89, c: 0x98BADCFE, d: 0x10325476, tail: [], total: 0 }
}

fn rotl(x: int, c: int) -> int {
    ((x & ((1 << (32 - c)) - 1)) << c) | (x >> (32 - c))
}

// One 64-byte block of `data` starting at `off`.
fn block(h: Md5, data: bytes, off: int) {
    var m: [int] = [];
    for j in 0..16 {
        let p = off + j * 4;
        m.push(data[p] | (data[p + 1] << 8) | (data[p + 2] << 16) | (data[p + 3] << 24));
    }
    var a = h.a;
    var b = h.b;
    var c = h.c;
    var d = h.d;
    for i in 0..64 {
        var f = 0;
        var g = 0;
        if (i < 16) {
            f = (b & c) | ((~b & MASK) & d);
            g = i;
        } else if (i < 32) {
            f = (d & b) | ((~d & MASK) & c);
            g = (5 * i + 1) % 16;
        } else if (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) % 16;
        } else {
            f = c ^ (b | (~d & MASK));
            g = (7 * i) % 16;
        }
        let sum = (a + f + K[i] + m[g]) & MASK;
        a = d;
        d = c;
        c = b;
        b = (b + rotl(sum, S[i])) & MASK;
    }
    h.a = (h.a + a) & MASK;
    h.b = (h.b + b) & MASK;
    h.c = (h.c + c) & MASK;
    h.d = (h.d + d) & MASK;
}

/// Feeds `data`.
pub fn update(h: Md5, data: bytes) {
    h.total = h.total + data.len();
    var pos = 0;
    if (h.tail.len() > 0) {
        while (h.tail.len() < 64 && pos < data.len()) {
            h.tail.push(data[pos]);
            pos = pos + 1;
        }
        if (h.tail.len() < 64) {
            return;
        }
        block(h, bytes_of(h.tail), 0);
        h.tail = [];
    }
    while (pos + 64 <= data.len()) {
        block(h, data, pos);
        pos = pos + 64;
    }
    while (pos < data.len()) {
        h.tail.push(data[pos]);
        pos = pos + 1;
    }
}

fn le32(x: int) -> [int] {
    [x & 0xFF, (x >> 8) & 0xFF, (x >> 16) & 0xFF, (x >> 24) & 0xFF]
}

/// The 16-byte digest. `h` is spent afterwards.
pub fn finish(h: Md5) -> bytes {
    let bits = h.total * 8;
    var pad: [int] = [0x80];
    while ((h.tail.len() + pad.len()) % 64 != 56) {
        pad.push(0);
    }
    for i in 0..8 {
        pad.push((bits >> (8 * i)) & 0xFF);
    }
    update(h, bytes_of(pad));
    bytes_of(le32(h.a) + le32(h.b) + le32(h.c) + le32(h.d))
}

pub fn hex_of(data: bytes) -> string {
    let h = new();
    update(h, data);
    hex.hex_encode(finish(h))
}
